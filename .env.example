# Configure one or more model providers. Replace placeholders before running.
AI_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-id

# Optional Azure OpenAI-compatible provider
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_AUTH_MODE=api-key

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=your-model-id

# Optional external definition lookup
TAVILY_API_KEY=

# Optional primary OCR provider
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Optional secondary OCR provider
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCAI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

FIELD_CONFIDENCE_THRESHOLD=0.85
HANDWRITTEN_CONFIDENCE_PENALTY=0.20
DATAPILOT_LOG_LEVEL=INFO
