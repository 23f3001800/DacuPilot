# ==============================================================================
# DocuPilot Environment Configuration Template (.env.example)
# Copy this file to .env and configure the services for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Provider Selection
# Options: "openai", "gemini", or "azure"
# If unset, DocuPilot auto-detects based on configured API keys.
# ------------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=openai

# ------------------------------------------------------------------------------
# 2. Pure OpenAI & OpenAI-Compatible Custom Endpoints
# Use standard OpenAI API or point to ANY OpenAI-compatible API endpoint
# (e.g. Ollama, Groq, vLLM, DeepSeek, Together, LM Studio, etc.)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
# Custom Base URL / Endpoint (defaults to https://api.openai.com/v1):
# Examples:
#   - Official OpenAI:  https://api.openai.com/v1
#   - Local Ollama:     http://localhost:11434/v1
#   - Local vLLM:       http://localhost:8000/v1
#   - Groq API:         https://api.groq.com/openai/v1
#   - DeepSeek:         https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. Google Gemini Configuration (Fallback or Primary)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Azure OpenAI / Azure AI Foundry Configuration
# ------------------------------------------------------------------------------
# Auth mode: "api-key" (default) or "azure-cli"
AZURE_OPENAI_AUTH_MODE=api-key
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
AZURE_OPENAI_MODEL=gpt-4o

# (Optional Azure Foundry Aliases):
# AZURE_FOUNDRY_API_KEY=your-foundry-api-key
# AZURE_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.openai.azure.com
# AZURE_FOUNDRY_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 5. Google Cloud Document AI OCR
# Powers multi-page enterprise OCR for identity and financial documents.
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
DOCAI_PROCESSOR_ID=your-processor-id
# Path to your Google Service Account JSON key:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------------------------
# 6. Azure Document Intelligence OCR (Alternative/Secondary OCR)
# ------------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-document-intelligence-key

# ------------------------------------------------------------------------------
# 7. Grounding & Web Search
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# ------------------------------------------------------------------------------
# 8. Document Pipeline Safety Thresholds & Logging
# ------------------------------------------------------------------------------
# Confidence shield threshold (0.0 to 1.0) below which fields require human review
FIELD_CONFIDENCE_THRESHOLD=0.85
# Penalty applied when handwritten text medium is detected
HANDWRITTEN_CONFIDENCE_PENALTY=0.20

DATAPILOT_LOG_LEVEL=INFO
DATAPILOT_LOG_FILE=agent_server.log
